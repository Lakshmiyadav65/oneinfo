# Root-level ignores. frontend/ and backend/ also keep their own.

# environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/

# Per-developer Claude Code settings. The shared ones (if any) belong in
# .claude/settings.json; the .local. variant is one person's machine and
# reached the repo once already by riding along in a merge.
.claude/settings.local.json
**/.claude/settings.local.json

# Python (backend/, in case tools run from repo root)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

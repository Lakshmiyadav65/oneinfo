# Frontend-safe configuration only.
# Never place provider secrets (Gemini, Groq, OpenAI, Veo, storage, Supabase
# service-role key, database credentials) in this file or in frontend code.
# Those belong to the backend's own environment configuration (Phase 05).

# Supabase (public) — leave blank to run in local development/mock auth mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL this app is served from.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the OneInfo application backend API.
# Leave blank until Phase 02 stands up the backend — the frontend falls
# back to empty-state placeholders when this is unset.
NEXT_PUBLIC_API_URL=

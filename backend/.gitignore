__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.env
# ...and every variant of it. A stray .env.bak or .env.local is just as
# much a secret as .env itself, and none of them are ignored by ".env" alone.
.env.*
!.env.example

# local dev storage (LocalStorageProvider)
data/

# portable FFmpeg build (~200MB) — see README for how to fetch it
tools/

# Google Cloud service account keys (Veo/GCS) — never commit these
credentials/

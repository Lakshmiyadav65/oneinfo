# Server-only configuration. Never expose these to a browser.

ENVIRONMENT=development

# Supabase Postgres connection string, asyncpg driver.
# Get this from Supabase: Project Settings -> Database -> Connection string (URI).
# Rewrite "postgresql://" to "postgresql+asyncpg://" at the start.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oneinfo

# Supabase: Project Settings -> API.
# Leave both unset to run in dev-mock auth mode (mirrors the frontend's
# Phase 01 mock auth) — never leave unset in production.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Background jobs (not required yet — routes currently use FastAPI
# BackgroundTasks until Redis is provisioned in Phase 05).
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# "dev" needs no key (deterministic hashed embeddings, for pipeline testing
# only). Set to "gemini" + GEMINI_API_KEY for real semantic retrieval.
EMBEDDING_PROVIDER=dev
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=

# "dev" needs no key (deterministic templated content, for pipeline testing
# only — not creatively good). Set to "gemini" for real hooks/scripts/etc,
# reusing the same GEMINI_API_KEY above.
LLM_PROVIDER=dev
HOOK_CANDIDATE_COUNT=4

RAG_TOP_K=5
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=60
MAX_UPLOAD_BYTES=10485760

# "dev" needs no credentials (renders a real local placeholder clip per
# scene via FFmpeg, for pipeline testing only). Set to "veo" + the Google
# Cloud settings below for real generated video.
VIDEO_PROVIDER=dev
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
VEO_MODEL=veo-3.0-generate-001

# FFmpeg/ffprobe binaries. Leave as-is if they're on PATH, or point at a
# portable build's full path (e.g. backend/tools/ffmpeg/bin/ffmpeg.exe).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30

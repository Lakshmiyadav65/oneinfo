# Server-only configuration. Never expose these to a browser.

ENVIRONMENT=development

# Supabase Postgres connection string, asyncpg driver.
# Get this from Supabase: Project Settings -> Database -> Connection string (URI).
# Rewrite "postgresql://" to "postgresql+asyncpg://" at the start.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oneinfo

# Supabase: Project Settings -> API.
# Leave both unset to run in dev-mock auth mode (mirrors the frontend's
# Phase 01 mock auth) — never leave unset in production.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Background jobs (not required yet — routes currently use FastAPI
# BackgroundTasks until Redis is provisioned in Phase 05).
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# "dev" needs no key (deterministic hashed embeddings, for pipeline testing
# only). Set to "gemini" + GEMINI_API_KEY for real semantic retrieval.
EMBEDDING_PROVIDER=dev
EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=

RAG_TOP_K=5
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=60
MAX_UPLOAD_BYTES=10485760

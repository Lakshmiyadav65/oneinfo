# Server-only configuration. Never expose these to a browser.
# Copy to .env and fill in. Never commit .env — see README's account
# checklist for exactly where each credential below comes from.

ENVIRONMENT=development

# Supabase Postgres connection string, asyncpg driver.
# Get this from Supabase: Project Settings -> Database -> Connection string (URI).
# Rewrite "postgresql://" to "postgresql+asyncpg://" at the start.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oneinfo

# Supabase: Project Settings -> API.
# Leave both unset to run in dev-mock auth mode (mirrors the frontend's
# Phase 01 mock auth) — never leave unset in production.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Background jobs. Routes currently use FastAPI BackgroundTasks regardless
# of these two — deferred switching to real Celery+Redis dispatch until
# Redis is actually provisioned (no Docker in this dev environment, Redis
# doesn't run natively on Windows). The Celery task code already exists
# (app/workers/) and calls the same pipeline functions the BackgroundTasks
# path does, so flipping it on later is a small, contained change, not a
# rewrite.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# "local" (default) writes under ./data/uploads — fine for dev, not
# durable/shared storage. "gcs" needs STORAGE_BUCKET and
# GOOGLE_APPLICATION_CREDENTIALS (below) with Storage Object Admin on
# that bucket.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_BUCKET=

# Embeddings. "dev" (default) needs no key — deterministic hashed
# embeddings, good enough to prove the pipeline, not semantically strong.
EMBEDDING_PROVIDER=dev
EMBEDDING_DIMENSIONS=768

# Content agents (hooks/script/Tanglish/storyboard). "dev" (default)
# needs no key — deterministic templated output, clearly marked
# "[DEV MODE]", proves the pipeline but isn't creatively good.
LLM_PROVIDER=dev
HOOK_CANDIDATE_COUNT=5
IDEA_SUGGESTION_COUNT=5

# Google: powers Gemini (LLM_PROVIDER=gemini / EMBEDDING_PROVIDER=gemini),
# Veo (VIDEO_PROVIDER=veo), and GCS (STORAGE_BACKEND=gcs) — one service
# account covers all three once Vertex AI + Storage Object Admin roles are
# granted. GOOGLE_APPLICATION_CREDENTIALS is the path to that account's
# downloaded JSON key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
VEO_MODEL=veo-3.0-generate-001

# Optional per the master spec — fast/low-cost LLM alternative.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional per the master spec — fallback LLM and/or embedding provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional — error monitoring. No-op (nothing initialized) when unset.
SENTRY_DSN=

RAG_TOP_K=5
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=60
MAX_UPLOAD_BYTES=10485760

# "dev" (default) renders a real, playable local placeholder clip per
# scene via FFmpeg — no Google Cloud needed, proves the pipeline. "veo"
# needs the Google Cloud settings above.
VIDEO_PROVIDER=dev

# Reading a creator's own reels into My Knowledge. "dev" (default) needs no
# key — it produces a placeholder transcript clearly marked "[DEV MODE]",
# which proves the download/extract/chunk/embed path without spending
# anything. "sarvam" needs SARVAM_API_KEY (the same key as the voice above)
# and is the one that transcribes Telugu/English code-switched speech
# properly. FFMPEG_PATH/FFPROBE_PATH below are required either way.
TRANSCRIPTION_PROVIDER=dev
SARVAM_STT_MODEL=saaras:v3

# Where the audio gets cut before it is sent. The real-time endpoint takes
# roughly 30s per request, and the cut is taken at the first pause after
# MIN rather than at a target length — waiting for a target sails past the
# pause between a Telugu sentence and an English one, and a chunk holding
# both comes back written entirely in one script. MAX is the fallback for a
# stretch with no pause in it at all. If whole sentences land in the wrong
# script, lower MIN toward 0.5 and raise SILENCE_DB toward -25 so pauses
# under background music still register.
TRANSCRIPTION_MIN_CHUNK_SECONDS=1.0
TRANSCRIPTION_MAX_CHUNK_SECONDS=25.0
TRANSCRIPTION_SILENCE_DB=-30
TRANSCRIPTION_SILENCE_MIN_SECONDS=0.3

# Downloads a pasted reel link. Installed with the backend's dependencies,
# and found without this being set: pip puts it beside the interpreter
# (.venv/Scripts), which is only on PATH when the virtualenv is activated,
# so it falls back to running as a module through the interpreter already
# serving. Set this only to point at a different or system-wide build.
YTDLP_PATH=yt-dlp

# Ceiling for a video reaching the transcriber, whether downloaded from a
# link or uploaded by hand. The video itself is never stored — only the
# transcript is — so this bounds the disk a single request touches, not
# anything kept.
MAX_VIDEO_BYTES=209715200

# FFmpeg/ffprobe binaries — required even in VIDEO_PROVIDER=dev (there's
# no pure-Python fallback for real video composition). Leave as-is if
# they're on PATH, or point at a portable build's full path (e.g.
# backend/tools/ffmpeg/bin/ffmpeg.exe) — see README's Setup section.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30

# Font for burned-in captions. Required for non-Latin scripts (Telugu):
# Windows: C:/Windows/Fonts/Nirmala.ttc | Linux: a Noto Sans Telugu path
CAPTION_FONT_PATH=

# An avatar capture is an order of magnitude larger than a reference photo,
# so it gets its own ceiling rather than MAX_UPLOAD_BYTES.
MAX_RECORDING_BYTES=62914560

# Separate database for the test suite. The DB-backed tests truncate every
# table between cases and seed creator-a/creator-b (the same ids dev-mock auth
# uses), so they refuse to run against DATABASE_URL. Leave blank to skip them.
TEST_DATABASE_URL=
